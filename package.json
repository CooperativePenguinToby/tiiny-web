{
  "name": "tiiny-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "format:write": "node ./node_modules/prettier/bin/prettier.cjs --write \"**/*.{js,jsx,mjs,ts,tsx,mdx}\" --cache",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"**/*.{js,jsx,mjs,ts,tsx,mdx}\" --cache",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "screenshots": "node ./node_modules/@playwright/test/cli.js test --config scripts/screenshots.config.ts"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@mui/material": "9.5.0",
    "@mui/system": "9.5.0",
    "@mui/utils": "9.5.0",
    "@phosphor-icons/react": "2.1.10",
    "dayjs": "1.11.23",
    "http-proxy": "^1.18.1",
    "i18next": "26.5.3",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.0",
    "selfsigned": "^5.5.0",
    "undici": "^8.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.1",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
