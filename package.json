{
  "name": "tiiny-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "format:write": "node ./node_modules/prettier/bin/prettier.cjs --write \"**/*.{js,jsx,mjs,ts,tsx,mdx}\" --cache",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"**/*.{js,jsx,mjs,ts,tsx,mdx}\" --cache",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@mui/lab": "7.0.0-beta.13",
    "@mui/material": "7.1.1",
    "@mui/system": "7.1.1",
    "@mui/utils": "7.1.1",
    "@mui/x-date-pickers": "8.29.5",
    "@phosphor-icons/react": "2.1.10",
    "dayjs": "1.11.23",
    "http-proxy": "^1.18.1",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "selfsigned": "^5.5.0",
    "undici": "^8.12.2",
    "zod": "3.25.57"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.28.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.28.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unicorn": "59.0.1",
    "globals": "16.2.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2"
  }
}
